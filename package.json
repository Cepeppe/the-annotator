{
  "name": "custom-labeler",
  "productName": "the-annotator",
  "version": "1.0.0",
  "private": true,
  "description": "Offline annotation tool for YOLO object detection datasets",
  "keywords": [
    "yolo",
    "annotation",
    "bounding-box",
    "object-detection",
    "dataset",
    "electron",
    "offline"
  ],
  "homepage": "https://github.com/Cepeppe/the-annotator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cepeppe/the-annotator.git"
  },
  "bugs": {
    "url": "https://github.com/Cepeppe/the-annotator/issues"
  },
  "main": "out/main/index.js",
  "author": {
    "name": "Cepeppe",
    "url": "https://github.com/Cepeppe"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon:gen": "node scripts/generate-icon.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.8",
    "fabric": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "^2.3.0",
    "happy-dom": "^15.11.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
